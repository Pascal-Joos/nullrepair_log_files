                    rerunFromTask.setStatus(SCHEDULED);
                    addTaskToQueue(rerunFromTask);
                }
            }
            executionDAOFacade.updateTask(rerunFromTask);
            decide(workflow.getWorkflowId());
            return true;
        }
        return false;
}
