                        .append(" ");
            }
        }
        if (allDone || hasFailures || optionalTaskFailures.length() > 0) {
            if (hasFailures) {
                task.setReasonForIncompletion(failureReason.toString());
                task.setStatus(TaskModel.Status.FAILED);
            } else if (optionalTaskFailures.length() > 0) {
