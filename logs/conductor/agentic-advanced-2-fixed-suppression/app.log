                // Tune the SystemTaskWorkerCoordinator's queues - if the queue size is very big this
                // can happen!
                LOGGER.info("Task {}/{} was already completed.", task.getTaskType(), task.getTaskId());
                queueDAO.remove(queueName, task.getTaskId());
                return;
            }
    
