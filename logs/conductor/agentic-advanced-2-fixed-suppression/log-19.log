private void populateWorkflowTaskWithDefinition(WorkflowTask workflowTask) {
                Utils.checkNotNull(workflowTask, "WorkflowTask cannot be null");
                WorkflowTask nonNullWorkflowTask = Nullability.castToNonnull(workflowTask);
                if (shouldPopulateTaskDefinition(nonNullWorkflowTask)) {
                    Nullability.castToNonnull(workflowTask).setTaskDefinition(metadataDAO.getTaskDef(Nullability.castToNonnull(workflowTask).getName()));
                    if (nonNullWorkflowTask.getTaskDefinition() == null
                            && nonNullWorkflowTask.getType().equals(TaskType.SIMPLE.name())) {
                        // ad-hoc task def
                        nonNullWorkflowTask.setTaskDefinition(new TaskDef(nonNullWorkflowTask.getName()));
                    }
                }
                if (nonNullWorkflowTask.getType().equals(TaskType.SUB_WORKFLOW.name())) {
                    populateVersionForSubWorkflow(nonNullWorkflowTask);
                }
}

