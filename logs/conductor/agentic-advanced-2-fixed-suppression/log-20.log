                        .filter(task -> !executedTaskRefNames.contains(task.getReferenceTaskName()))
                        .collect(Collectors.toList());
        if (!unScheduledTasks.isEmpty()) {
            LOGGER.debug(
                    "Scheduling Tasks: {} for workflow: {}",
                    unScheduledTasks.stream()
