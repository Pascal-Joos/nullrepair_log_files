                    || (outcome.tasksToBeScheduled.isEmpty() && checkForWorkflowCompletion(workflow))) {
                LOGGER.debug("Marking workflow: {} as complete.", workflow);
                outcome.isComplete = true;
            }
    
            return outcome;
