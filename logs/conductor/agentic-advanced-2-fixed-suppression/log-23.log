        if (systemTaskRegistry.isSystemTask(task.getTaskType())
                && (TaskType.TASK_TYPE_DECISION.equals(task.getTaskType())
                        || TaskType.TASK_TYPE_SWITCH.equals(task.getTaskType()))) {
