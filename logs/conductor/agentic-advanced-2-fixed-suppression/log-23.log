                                                            return wd;
                                                        }))
                                .map(
                                        wd ->
                                                wd.getTaskByRefName(
                                                        pendingTask.getReferenceTaskName()))
                                .map(WorkflowTask::getTaskDefinition);
            }

            if (taskDefinition.isPresent()) {
                checkTaskTimeout(taskDefinition.get(), pendingTask);
