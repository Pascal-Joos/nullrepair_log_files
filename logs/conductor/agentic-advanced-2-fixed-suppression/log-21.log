                                                workflow.getTasks().stream()
                                                        .filter(
                                                                task ->
                                                                        !task.getStatus().isTerminal()
                                                                                && task.getReferenceTaskName()
                                                                                        .equals(
                                                                                                taskRefName))
                                                        .findFirst();
                                    }
    
                                    if (optionalTaskModel.isEmpty()) {
                                        LOGGER.error(
