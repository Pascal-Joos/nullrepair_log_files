                String paramPath = values[i].substring(2, values[i].length() - 1);
                // if the paramPath is blank, meaning no value in between ${ and }
                // like ${}, ${  } etc, set the value to empty string
                if (StringUtils.isBlank(paramPath)) {
                    convertedValues[i] = "";
                    continue;
