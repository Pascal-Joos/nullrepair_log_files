        return taskMappers
                .getOrDefault(type, taskMappers.get(USER_DEFINED.name()))
                .getMappedTasks(taskMapperContext)
                .stream()
                .filter(task -> !tasksInWorkflow.contains(task.getReferenceTaskName()))
                .collect(Collectors.toList());
}
