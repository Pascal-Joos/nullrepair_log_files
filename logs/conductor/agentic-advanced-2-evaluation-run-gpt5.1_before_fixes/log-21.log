public static String getQueueName(
            String taskType,
            @Nullable String domain,
            @Nullable String isolationGroupId,
            @Nullable String executionNamespace) {

        String queueName;
        if (domain == null) {
            queueName = taskType;
        } else {
            queueName = domain + DOMAIN_SEPARATOR + taskType;
