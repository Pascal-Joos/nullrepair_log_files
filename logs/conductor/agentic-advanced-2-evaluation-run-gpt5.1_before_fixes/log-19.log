                    doWhileTaskModel.setIteration(doWhileTaskModel.getIteration() + 1);
                    doWhileTaskModel.addOutput("iteration", doWhileTaskModel.getIteration());
                    return scheduleNextIteration(doWhileTaskModel, workflow, workflowExecutor);
                } else {
