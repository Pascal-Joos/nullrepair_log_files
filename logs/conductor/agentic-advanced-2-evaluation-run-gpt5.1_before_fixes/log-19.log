                    }
                } catch (ScriptException e) {
                    String message =
                            String.format(
                                    "Unable to evaluate condition %s, exception %s",
                                    Optional.ofNullable(doWhileTaskModel.getWorkflowTask())
                                            .map(WorkflowTask::getLoopCondition)
