                conditionInput.put(
                        TaskUtils.removeIterationFromTaskRefName(loopOverTask.getReferenceTaskName()),
                        loopOverTask.getOutputData());
            }
    
            String condition = workflowTask.getLoopCondition();
            boolean result = false;
            if (condition != null) {
