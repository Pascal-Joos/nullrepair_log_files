    void checkTaskPollTimeout(TaskDef taskDef, TaskModel task) {
        if (taskDef == null) {
            LOGGER.warn(
                    "Missing task definition for task:{}/{} in workflow:{}",
                    task.getTaskId(),
                    task.getTaskDefName(),
                    task.getWorkflowInstanceId());
            return;
