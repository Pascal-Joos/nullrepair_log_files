        Utils.checkNotNull(workflowTask, "WorkflowTask cannot be null");
        if (shouldPopulateTaskDefinition(Nullability.castToNonnull(workflowTask))) {
            workflowTask.setTaskDefinition(Nullability.castToNonnull(metadataDAO.getTaskDef(workflowTask.getName())));
