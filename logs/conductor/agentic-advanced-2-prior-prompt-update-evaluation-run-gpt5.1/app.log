                            .orElseThrow(
                                    () ->
                                            new NotFoundException(
                                                    "No such task found by id: %s",
                                                    taskResult.getTaskId()));
    
            LOGGER.debug("Task: {} belonging to Workflow {} being updated", task, workflowInstance);
    
