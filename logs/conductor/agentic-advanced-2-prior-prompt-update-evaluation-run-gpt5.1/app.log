                workflowModel, ExternalPayloadStorage.PayloadType.WORKFLOW_INPUT);
        externalPayloadStorageUtils.verifyAndUpload(
                workflowModel, ExternalPayloadStorage.PayloadType.WORKFLOW_OUTPUT);
