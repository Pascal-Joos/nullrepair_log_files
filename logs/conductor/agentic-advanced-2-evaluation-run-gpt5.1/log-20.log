              Map<String, Object> taskInput =
                      parametersUtils.getTaskInputV2(
                              workflowTask.getInputParameters(),
                              workflowModel,
                              doWhileTask.getTaskId(),
                              taskDefinition);
              doWhileTask.setInputData(taskInput);
              return List.of(doWhileTask);
}
}
