class com.netflix.conductor.core.utils.ParametersUtils {
public Map<String, Object> getTaskInputV2(
            Map<String, Object> input,
            WorkflowModel workflow,
            @Nullable String taskId,
            @Nullable TaskDef taskDefinition) {
