class com.netflix.conductor.core.events.queue.DefaultEventQueueProcessor {
private void startMonitor(Status status, ObservableQueue queue) {
    
            queue.observe()
                    .subscribe(
                            (Message msg) -> {
                                try {
                                    LOGGER.debug("Got message {}", msg.getPayload());
