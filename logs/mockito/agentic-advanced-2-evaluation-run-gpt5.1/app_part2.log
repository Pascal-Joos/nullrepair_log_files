      List<Stubbing> fromSingleMock =
          MockUtil.getInvocationContainer(mock).getStubbingsDescending();
      for (Stubbing s : fromSingleMock) {
        if (!s.wasUsed()) {
          unused.add(s.getInvocation());
        }
      }
    }
    return unused;
}
