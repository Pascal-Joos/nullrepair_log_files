class org.mockito.internal.stubbing.defaultanswers.TriesToReturnSelf {
@Nullable public Object answer(InvocationOnMock invocation) throws Throwable {
      Class<?> methodReturnType = invocation.getMethod().getReturnType();
      Object mock = invocation.getMock();
      Class<?> mockType = Nullability.castToNonnull(MockUtil.getMockHandler(mock)).getMockSettings().getTypeToMock();
  
      if (methodReturnType.isAssignableFrom(mockType)) {
        return invocation.getMock();
      }
  
      return defaultReturn.returnValueFor(methodReturnType);
