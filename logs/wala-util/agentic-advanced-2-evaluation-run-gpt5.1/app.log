              int ai = 0;
              int al = size;
              int[] br = that.elements;
              int bi = 0;
              int bl = that.size;
              int[] cr = null; // allocate on demand
              int ci = 0;
          
              while (ar != null && br != null && ai < al && bi < bl) {
                int cmp = (ar[ai] - br[bi]);
          
                // (accept element only on a match)
                if (cmp > 0) { // a greater
                  bi++;
                } else if (cmp < 0) { // b greater
                  ai++;
