                return;
              } else if (that.isEmpty()) {
                elements = null;
                size = 0;
                return;
              } else if (this.equals(that)) {
                return;
              }
          
              // some simple optimizations
              if (size == 1) {
                if (elements != null && that.contains(elements[0])) {
                  return;
                } else {
                  elements = null;
                  size = 0;
                  return;
                }
              }
              if (that.size == 1) {
                if (that.elements != null && contains(that.elements[0])) {
                  if (size > getInitialNonEmptySize()) {
                    elements = new int[getInitialNonEmptySize()];
                  }
                  size = 1;
                  if (elements != null) {
                    elements[0] = that.elements[0];
