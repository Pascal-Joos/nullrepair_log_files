    if (getInput() != null) {
      try (final BufferedOutputStream input = new BufferedOutputStream(p.getOutputStream())) {
        input.write(getInput(), 0, getInput().length);
        input.flush();
      } catch (IOException e) {
        e.printStackTrace();
        throw new IOException("error priming stdin", e);
      }
    }
    try {
      d1.join();
