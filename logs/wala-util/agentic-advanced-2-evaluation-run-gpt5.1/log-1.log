          UnaryOperator<V> f = functions.getEdgeTransferFunction(node, succ);
          if (!f.isIdentity()) {
            newStatement(
                getEdge(node, succ),
                f,
                functions.hasNodeTransferFunctions() ? getOut(node) : getIn(node),
                toWorkList,
                eager);
          }
        }
      }
    }
}
