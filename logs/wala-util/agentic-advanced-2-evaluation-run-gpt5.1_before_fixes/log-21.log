          IntSet preds = acyclic.getPredNodeNumbers(node);
          if (preds == null) {
            continue;
          }
          for (IntIterator it = preds.intIterator(); it.hasNext(); ) {
            worklist.add(Path.prepend(it.next(), p));
          }
        }
      }

      return result;
  }
