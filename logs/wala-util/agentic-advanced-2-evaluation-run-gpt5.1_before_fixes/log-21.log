      Collection<Path> worklist = HashSetFactory.make();
      Path sinkPath = Path.make(G.getNumber(sink));
      worklist.add(sinkPath);
      while (!worklist.isEmpty() && result.size() <= max) {
        Path p = worklist.iterator().next();
        worklist.remove(p);
        int first = p.get(0);
        if (first == G.getNumber(src)) {
          result.add(p);
