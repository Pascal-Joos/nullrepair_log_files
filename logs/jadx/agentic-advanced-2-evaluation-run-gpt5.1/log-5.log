   		if (nameMap == null) {
   			throw new JadxRuntimeException("Classpath must be loaded first");
   		}
   		Map<String, Set<String>> map = new HashMap<>(Nullability.castToNonnull(nameMap).size());
   		Set<String> tmpSet = new HashSet<>();
