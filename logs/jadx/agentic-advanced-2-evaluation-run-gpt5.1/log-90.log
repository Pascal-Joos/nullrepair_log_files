class jadx.core.codegen.NameGen {
private String makeArgName(CodeVar var) {
		String name = var.getName();
		if (name == null) {
			name = guessName(var);
		}
		if (!NameMapper.isValidAndPrintable(name)) {
			name = getFallbackName(var);
		}
		return name;
}
