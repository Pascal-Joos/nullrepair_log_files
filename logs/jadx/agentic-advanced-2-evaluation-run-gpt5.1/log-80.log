class jadx.core.dex.visitors.ShadowFieldVisitor {
@Override
	public void visit(MethodNode mth) throws JadxException {
		if (mth.isNoCode()) {
			return;
		}
		fixShadowFieldAccess(mth, fixInfoMap);
}
}
