 			PackageNode subPkg = pkg;
 			for (int i = aliasParts.length - 1; i >= 0; i--) {
 				String aliasPart = aliasParts[i];
 				if (!subPkg.getName().equals(aliasPart)) {
 					subPkg.setAlias(aliasPart);
 				}
 				subPkg = subPkg.getParentPackage();
