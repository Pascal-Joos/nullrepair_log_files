			}
		}
		for (FieldNode field : cls.getFields()) {
			if (field.contains(AFlag.DONT_RENAME)) {
				continue;
			}
			renameField(field);
		}
		mthProcessQueue.addAll(cls.getMethods());

		for (ClassNode innerCls : cls.getInnerClasses()) {
			processClass(innerCls);
		}
}
}
