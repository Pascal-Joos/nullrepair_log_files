public void visitParentClasses(Consumer<ClassNode> consumer) {
       ClassNode currentCls = this;
       ClassNode parentCls = Nullability.castToNonnull(currentCls.getParentClass());
       while (parentCls != currentCls) {
           consumer.accept(parentCls);
           currentCls = parentCls;
           parentCls = Nullability.castToNonnull(currentCls.getParentClass());
       }
}
@ApiStatus.Internal
	JavaClass convertClassNode(ClassNode cls) {
		return classesMap.compute(cls, (node, prevJavaCls) -> {
			if (prevJavaCls != null && prevJavaCls.getClassNode() == cls) {
				// keep previous variable
				return prevJavaCls;
			}
			if (cls.isInner()) {
				return new JavaClass(cls, convertClassNode(cls.getParentClass()));
			}
			return new JavaClass(cls, this);
		});
}
