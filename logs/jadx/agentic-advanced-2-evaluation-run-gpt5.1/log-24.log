		if (!Objects.equals(name, aliasName)) {
			ClassAliasInfo newAlias = new ClassAliasInfo(getAliasPkg(), aliasName);
			fillAliasFullName(newAlias);
			this.alias = newAlias;
		} else {
			this.alias = null;
		}
