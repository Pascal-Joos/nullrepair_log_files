public RegisterArg bindArg(BlockNode pred) {
 		RegisterArg res = getResult();
 		if (res == null) {
 			return null;
 		}
 		RegisterArg arg = InsnArg.reg(res.getRegNum(), res.getInitType());
 		bindArg(arg, pred);
 		return arg;
}@Override
	public String toString() {
		return "PHI: " + getResult() + " = " + Utils.listToString(getArguments())
				+ " binds: " + blockBinds;
}
