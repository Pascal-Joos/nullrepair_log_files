		if (mthInfo.getArgumentsTypes().size() > 255) {
			// java spec don't allow more than 255 args
			if (canRemoveMethod(mth)) {
				mth.ignoreMethod();
			} else {
				// TODO: convert args to array
			}
		}
		checkInstructions(mth);
}
