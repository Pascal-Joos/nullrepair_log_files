private void addInsnBody(InsnGen insnGen, ICodeWriter code, InsnNode insn) {
		try {
			insnGen.makeInsn(insn, code, InsnGen.Flags.BODY_ONLY_NOWRAP);
		} catch (Exception e) {
			cls.addError("Failed to generate init code", e);
