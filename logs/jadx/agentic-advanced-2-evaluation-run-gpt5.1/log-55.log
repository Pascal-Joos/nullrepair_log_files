public static boolean isInstanceOf(RootNode root, ArgType type, ArgType of) {
 		if (type.equals(of)) {
 			return true;
 		}
 		if (!type.isObject() || !of.isObject()) {
 			return false;
 		}
 		if (root == null) {
 			return false;
