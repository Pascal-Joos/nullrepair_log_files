 			if (primitiveType == null) {
 				return "unknown";
 			}
 			return primitiveType.getShortName().toLowerCase();
 		}
 		if (type.isArray()) {
 			return makeNameForType(type.getArrayRootElement()) + "Arr";
 		}
 		return makeNameForObject(type);
