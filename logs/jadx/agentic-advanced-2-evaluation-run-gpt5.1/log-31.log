			switch (result) {
				case CONFLICT:
					return -2;

				case WIDER:
				case WIDER_BY_GENERIC:
					return -1;

				case NARROW:
				case NARROW_BY_GENERIC:
					return 1;

				case EQUAL:
				default:
					return 0;
			}
