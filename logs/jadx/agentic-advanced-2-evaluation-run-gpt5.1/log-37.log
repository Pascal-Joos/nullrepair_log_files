class jadx.core.dex.instructions.args.RegisterArg {
public boolean sameCodeVar(RegisterArg arg) {
       return Nullability.castToNonnull(this.getSVar()).getCodeVar() == arg.getSVar().getCodeVar();
}@Override
	public boolean equals(@Nullable Object obj) {
		if (this == obj) {
			return true;
