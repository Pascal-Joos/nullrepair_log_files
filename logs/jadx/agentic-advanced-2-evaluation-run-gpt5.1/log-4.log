public void visitSuperTypes(ArgType type, BiConsumer<ArgType, ArgType> consumer) {
		ClassNode cls = root.resolveClass(type);
		if (cls != null) {
			cls.visitSuperTypes(consumer);
		} else {
			ClspClass clspClass = root.getClsp().getClsDetails(type);
			if (clspClass != null) {
