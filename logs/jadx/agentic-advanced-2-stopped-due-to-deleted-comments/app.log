			}
			return 1;
		}
		// no info found => treat as hierarchy end
		endTypes.add(superType.getObject());
		return 1;
}private void collectSuperTypes(ClassNode cls, List<ArgType> superTypes, Set<String> endTypes) {
		RootNode root = cls.root();
		int k = 0;
