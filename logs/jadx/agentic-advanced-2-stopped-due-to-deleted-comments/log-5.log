   		for (Map.Entry<String, ClspClass> entry : nameMap.entrySet()) {
   			ClspClass cls = entry.getValue();
   			tmpSet.clear();
   			addSuperTypes(cls, tmpSet);
   			Set<String> result;
   			if (tmpSet.isEmpty()) {
   				result = Collections.emptySet();
   			} else {
   				result = new HashSet<>(tmpSet);
   			}
   			map.put(cls.getName(), result);
   		}
   		superTypesCache = map;
}

