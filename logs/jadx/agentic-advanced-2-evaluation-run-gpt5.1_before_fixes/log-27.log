 		List<RegisterArg> callArgs = callMth.getArgRegs();
 		if (implArgs.isEmpty()) {
 			code.add("()");
 		} else {
 			int callArgsCount = callArgs.size();
 			int startArg = callArgsCount - implArgs.size();
 			for (int i = startArg; i < callArgsCount; i++) {
 				if (i != startArg) {
 					code.add(", ");
