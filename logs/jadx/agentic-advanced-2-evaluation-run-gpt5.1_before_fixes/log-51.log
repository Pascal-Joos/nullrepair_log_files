					BlockNode loopHeader = ((LoopRegion) region).getHeader();
					if (loopHeader != null && loopHeader.getInstructions().size() != 1) {
						mth.addWarn("Incorrect condition in loop: " + loopHeader);
					}
				}
				return true;
			}
		});
}
