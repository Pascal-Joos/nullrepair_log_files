		}
		return false;
}public boolean containsTypeVariable() {
		if (isGenericType()) {
			return true;
		}
		ArgType wildcardType = getWildcardType();
		if (wildcardType != null) {
			return wildcardType.containsTypeVariable();
		}
		if (isGeneric()) {
			List<ArgType> genericTypes = getGenericTypes();
			if (genericTypes != null) {
