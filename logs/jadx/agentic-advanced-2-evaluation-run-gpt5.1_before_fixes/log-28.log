class jadx.core.dex.visitors.typeinference.TypeCompare$ArgTypeComparator {
@Override
		public int compare(ArgType a, ArgType b) {
			TypeCompareEnum result = compareTypes(a, b);
			switch (result) {
				case CONFLICT:
					return -2;

				case WIDER:
				case WIDER_BY_GENERIC:
					return -1;

				case NARROW:
				case NARROW_BY_GENERIC:
					return 1;

				case EQUAL:
				default:
					return 0;
			}
}
}
