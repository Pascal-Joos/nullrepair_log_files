 				return compareWithUnknown(second, first).invert();
 			}
 		}
 		boolean firstArray = first.isArray();
 		boolean secondArray = second.isArray();
 		if (firstArray != secondArray) {
 			if (firstArray) {
 				return compareArrayWithOtherType(first, second);
 			} else {
