		exitBlock.add(AFlag.MTH_EXIT_BLOCK);
		mth.setExitBlock(exitBlock);

		Map<Integer, BlockNode> blocksMap = new HashMap<>();
		BlockNode curBlock = enterBlock;
		InsnNode prevInsn = null;
		for (InsnNode insn : mth.getInstructions()) {
			if (insn == null) {
