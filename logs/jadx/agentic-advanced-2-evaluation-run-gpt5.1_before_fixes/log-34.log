       			case INT_TO_FLOAT:
       				return cast(insn, ArgType.INT, ArgType.FLOAT);
       			case INT_TO_DOUBLE:
       				return cast(insn, ArgType.INT, ArgType.DOUBLE);
       			case INT_TO_LONG:
