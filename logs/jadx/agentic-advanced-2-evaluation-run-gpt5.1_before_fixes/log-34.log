class jadx.core.dex.instructions.args.ArgType {
public static ArgType parse(String type) {
 		if (type == null || type.isEmpty()) {
 			throw new JadxRuntimeException("Failed to parse type string: " + type);
 		}
 		char f = type.charAt(0);
 		switch (f) {
 			case 'L':
 				return object(type);
 			case 'T':
 				return genericType(type.substring(1, type.length() - 1));
 			case '[':
 				return array(Nullability.castToNonnull(parse(type.substring(1))));
 			default:
 				return parse(f);
 		}
}
}
