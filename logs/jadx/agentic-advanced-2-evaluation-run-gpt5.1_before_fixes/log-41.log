 				for (BlockNode p : end.getPredecessors()) {
 					if (list.contains(p)) {
 						if (p.isSynthetic()) {
 							p.getInstructions().add(new InsnNode(InsnType.CONTINUE, 0));
 						}
 						break;
 					}
 				}
 			}
 		}
