        double diffY;
        if (!this.grabMouse) {
          // get diff relative from last mouse location
          diffX = e.getX() - this.lastLocation.getX();
          diffY = e.getY() - this.lastLocation.getY();
          this.lastLocation = new Point(e.getX(), e.getY());
        } else {
