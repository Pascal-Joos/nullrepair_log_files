              (int) this.getLocation().getY(),
              0,
              false,
              MouseEvent.NOBUTTON);
      final MouseEvent wrappedEvent = this.createEvent(mouseEvent);
      for (final MouseMovedListener listener : this.mouseMovedListeners) {
        listener.mouseMoved(wrappedEvent);
      }
}
