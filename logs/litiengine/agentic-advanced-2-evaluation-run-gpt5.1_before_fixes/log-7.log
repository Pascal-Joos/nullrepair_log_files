@Override
    public int compare(final IEntity m1, final IEntity m2) {
      ICollisionEntity coll1 = null;
      ICollisionEntity coll2 = null;
      if (m1 instanceof ICollisionEntity) {
        coll1 = (ICollisionEntity) m1;
      }
  
      if (m2 instanceof ICollisionEntity) {
        coll2 = (ICollisionEntity) m2;
      }
  
      final Rectangle2D collBox1 = coll1 != null ? coll1.getCollisionBox() : null;
      final Rectangle2D collBox2 = coll2 != null ? coll2.getCollisionBox() : null;
  
      final double m1MaxY =
          collBox1 != null ? collBox1.getMaxY() : m1.getBoundingBox().getMaxY();
      final double m2MaxY =
          collBox2 != null ? collBox2.getMaxY() : m2.getBoundingBox().getMaxY();
      return Double.valueOf(m1MaxY).compareTo(m2MaxY);
}
