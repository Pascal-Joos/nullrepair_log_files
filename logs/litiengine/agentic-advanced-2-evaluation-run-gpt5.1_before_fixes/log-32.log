            new Color(
                this.getColor().getRed(),
                this.getColor().getGreen(),
                this.getColor().getBlue(),
                MathUtilities.clamp(ambientAlpha, 0, 255)));
        if (this.environment.getMap() != null) {
          this.updateSection(this.environment.getMap().getBounds());
        }
}
}
