        final String animationName = animationRule.getAnimationName().apply(this.getEntity());
        if (this.getCurrent() == null
            || animationName != null
                && !animationName.isEmpty()
                && !this.getCurrent().getName().equalsIgnoreCase(animationName)) {
          this.play(animationName);
        }

        break;
      }
    }
}
