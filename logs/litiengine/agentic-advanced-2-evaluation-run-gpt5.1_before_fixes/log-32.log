      this.loadMapObjects();
      this.addStaticShadows();
      this.addAmbientLight();
    }

    this.fireEvent(l -> l.initialized(this));
    this.initialized = true;
}public Environment(final String mapPath) {
    this(Resources.maps().get(mapPath));
}
