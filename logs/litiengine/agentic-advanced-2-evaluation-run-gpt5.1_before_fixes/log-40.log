          p.y -= image.getHeight();
          ITileOffset offset = tile.getTilesetEntry().getTileset().getTileOffset();
          if (offset != null) {
            p.x += offset.getX();
            p.y += offset.getY();
          }
          if (viewport.intersects(p.x, p.y, image.getWidth(), image.getHeight())) {
