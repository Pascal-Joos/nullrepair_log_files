                this.setHorizontalLowerBound(sliderValue.intValue());
                this.getHorizontalSlider()
                    .getSliderComponent()
                    .setLocation(this.getHorizontalSlider().getRelativeSliderPosition());
                this.refresh();
              });
    }
}
