                animationController.getAffineTransform(),
                0.25f);
          }
        }
      }
    }

    if (entity instanceof IRenderable) {
      ((IRenderable) entity).render(g);
    }

    if (entity instanceof EntityRenderListener) {
      ((EntityRenderListener) entity).rendered(renderEvent);
    }

