                  || !this.isArrowKeyNavigation()
                  || !this.getChosenElementComponent().isHovered()) {
                return;
              }
              this.getContentList().setSelection(0, this.getSelectedIndex() + 1);
            });

    this.onMouseWheelScrolled(
        e -> {
          if (this.isSuspended()
              || !this.isVisible()
              || !this.getChosenElementComponent().isHovered()) {
            return;
          }
          if (e.getEvent().getWheelRotation() < 0) {
            this.getContentList().setSelection(0, this.getSelectedIndex() - 1);
          } else {
            this.getContentList().setSelection(0, this.getSelectedIndex() + 1);
          }
          return;
        });
