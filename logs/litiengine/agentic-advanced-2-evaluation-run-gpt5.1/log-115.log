      super(entity);
      this.up = new ArrayList<>();
      this.down = new ArrayList<>();
      this.left = new ArrayList<>();
      this.right = new ArrayList<>();
  
      this.up.add(up);
      this.down.add(down);
      this.left.add(left);
      this.right.add(right);
