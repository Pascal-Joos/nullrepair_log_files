        final float y = gamepadManager.get(this.gamepadId).getPollData(Gamepad.Axis.Y);
  
        if (Math.abs(x) > this.gamepadDeadzone) {
          this.setDx(x);
        }
  
        if (Math.abs(y) > this.gamepadDeadzone) {
          this.setDy(y);
        }
  
