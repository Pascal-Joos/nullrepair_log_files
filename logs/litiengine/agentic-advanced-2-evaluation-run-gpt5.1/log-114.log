    if (this.getTimeScale() > 0) {
      super.process();
      this.executeTimedActions();
    }

    Game.world().camera().updateFocus();
    if (!Game.isInNoGUIMode()) {
      Game.window().getRenderComponent().render();
    }

    this.trackRenderMetric();
}
}
