        this.visible = true;
        if (Input.mouse() != null) {
            Input.mouse().addMouseListener(this);
            Input.mouse().onWheelMoved(this);
            Input.mouse().addMouseMotionListener(this);
        }
        for (final GuiComponent component : this.getComponents()) {
          component.prepare();
        }
}public void suspend() {
