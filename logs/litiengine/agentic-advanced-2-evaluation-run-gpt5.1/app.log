        this.setOffset(offsetX, offsetY);
  
        if (this.getImage() != null) {
          hideDefaultCursor();
          return;
        }
  
        final IMouse mouse = Input.mouse();
        if (mouse != null && !mouse.isGrabMouse()) {
          showDefaultCursor();
        }
}
