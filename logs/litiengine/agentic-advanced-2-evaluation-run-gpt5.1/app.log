private void updateAmbientLayers() {
    if (!this.isLoaded()) {
      return;
    }

    if (Game.world().environment() != null
        && Game.world().environment().getAmbientLight() != null) {
      Game.world().environment().getAmbientLight().updateSection(this.getBoundingBox());
    }

    if (Game.world().environment() != null
