        && this.selectionColumn >= 0
        && this.selectionColumn < this.nbOfColumns
        && this.selectionRow >= this.getVerticalLowerBound()
        && this.selectionRow < this.getVerticalLowerBound() + this.getNumberOfShownRows()) {
