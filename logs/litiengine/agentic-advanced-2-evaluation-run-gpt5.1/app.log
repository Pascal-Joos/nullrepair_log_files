      super(x, y, width, height, text);
      this.changeConfirmedConsumers = new CopyOnWriteArrayList<>();
      this.setText(text);
      this.flickerDelay = 100;
      Input.keyboard().onKeyTyped(this::handleTypedKey);
      this.onClicked(
          e -> {
            if (!this.isSelected()) {
              this.toggleSelection();
            }
          });
  
      final IMouse mouse = Input.mouse();
      if (mouse != null) {
        mouse.onClicked(
