public static BufferedImage addShadow(
      final BufferedImage image, final int xOffset, final int yOffset) {
    if (image == null) {
      return image;
    }

    final int width = image.getWidth();
    final int height = image.getHeight();
    if (width == 0 || height == 0) {
      return image;
