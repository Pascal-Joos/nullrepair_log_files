      Input.keyboard().onKeyTyped(this::handleTypedKey);
      this.onClicked(
          e -> {
            if (!this.isSelected()) {
              this.toggleSelection();
            }
          });
  
      final IMouse mouse = Input.mouse();
      if (mouse != null) {
        mouse.onClicked(
            e -> {
              if (!this.getBoundingBox().contains(mouse.getLocation())) {
                this.setSelected(false);
              }
            });
      }
  
      this.setTextAlign(Align.LEFT);
}
}
