        final double angle =
            GeometricUtilities.calcRotationAngleInDegrees(
                this.entity.getCollisionBox().getCenterX(),
                this.entity.getCollisionBox().getCenterY(),
                target.getX(),
                target.getY());
        this.entity.setAngle((float) angle);
}
