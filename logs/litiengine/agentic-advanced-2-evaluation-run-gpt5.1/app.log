        if (Game.config().graphics().getGraphicQuality().ordinal() >= Quality.MEDIUM.ordinal()
            && this.getAmbientLight() != null
            && this.getAmbientLight().getColor().getAlpha() != 0) {
          this.getAmbientLight().render(g);
