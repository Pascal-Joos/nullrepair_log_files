                new Point(
                    MathUtilities.clamp(maxTileX, 0, map.getWidth() - 1),
                    MathUtilities.clamp(maxTileY, 0, map.getHeight() - 1)),
                map);

    return new Rectangle2D.Double(
        minTileBounds.getX(),
        minTileBounds.getY(),
