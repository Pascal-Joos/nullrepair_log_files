    this.initKeyFrames(keyFrameDurations);
    if (this.getKeyframes().isEmpty()) {
      log.log(
          Level.WARNING,
          "No keyframes defined for animation {0} (spitesheet: {1})",
          new Object[] {this.getName(), spritesheet.getName()});
