}public void suspend() {
      if (Input.mouse() != null) {
        Input.mouse().removeMouseListener(this);
        Input.mouse().removeMouseWheelListener(this);
        Input.mouse().removeMouseMotionListener(this);
      }
      this.suspended = true;
      this.visible = false;
      for (final GuiComponent childComp : this.getComponents()) {
        childComp.suspend();
      }
}
}
