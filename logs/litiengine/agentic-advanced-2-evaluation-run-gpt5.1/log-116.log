    final double sliderHeight = (this.getHeight() - this.getWidth() * 2) * 1 / 6.0;
    this.minSliderY = this.getY() + this.getWidth();
    this.maxSliderY = this.getY() + this.getHeight() - (this.getWidth() + sliderHeight);
    this.setSliderComponent(
