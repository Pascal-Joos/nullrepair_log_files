                this.setValueRelativeToMousePosition();
                this.getChangeConsumer()
                    .forEach(consumer -> consumer.accept(this.getCurrentValue()));
              }
            });

    Input.mouse()
        .onReleased(
            e -> {
              if (this.isDragging()) {
                this.isDragging = false;
              }
            });
    this.getComponents().add(this.getSliderComponent());
}
}
