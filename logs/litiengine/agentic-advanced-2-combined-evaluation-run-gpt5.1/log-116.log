        drawTileBoundingBox(g, Nullability.castToNonnull(map), mouse.getMapLocation());
      }
  
      final MapRenderedEvent event = new MapRenderedEvent(g, Nullability.castToNonnull(map));
      for (MapRenderedListener cons : mapDebugListener) {
        cons.rendered(event);
