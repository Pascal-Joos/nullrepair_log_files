              new ResourceRecordSetWithHostedZone(rrs.getHostedZone(), resourceRecordSet));
        } else if (NULL_DOMAIN.equals(
            rrs.getResourceRecordSet().getResourceRecords().get(0).getValue())) {
          freeDomains.add(rrs);
        }
