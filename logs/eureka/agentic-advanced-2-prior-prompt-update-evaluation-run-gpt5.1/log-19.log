          if (createResourceRecordSet(rrs)) {
            logger.info("Bind {} to {}", registrationHostname, Nullability.castToNonnull(rrs.getResourceRecordSet(), "always nonnull in list").getName());
            return;
          }
        }
  
        logger.warn("Unable to find free domain in {}", domains);
}@Override
  @PostConstruct
  public void start() {
    try {
      doBind();
      timer.schedule(
          new TimerTask() {
            @Override
            public void run() {
              try {
                doBind();
              } catch (Throwable e) {
                logger.error("Could not bind to Route53", e);
              }
            }
          },
          serverConfig.getRoute53BindingRetryIntervalMs(),
          serverConfig.getRoute53BindingRetryIntervalMs());
    } catch (InterruptedException e) {
      throw new RuntimeException(e);
    }
}private void unbindFromDomain(String domain) throws InterruptedException {
        ResourceRecordSetWithHostedZone resourceRecordSetWithHostedZone =
