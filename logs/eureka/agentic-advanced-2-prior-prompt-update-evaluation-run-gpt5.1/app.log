        serverConfig.getRemoteRegionRegistryFetchInterval(),
        TimeUnit.SECONDS);

    try {
      Monitors.registerObject(this);
    } catch (Throwable e) {
      logger.warn("Cannot register the JMX monitor for the RemoteRegionRegistry :", e);
    }
