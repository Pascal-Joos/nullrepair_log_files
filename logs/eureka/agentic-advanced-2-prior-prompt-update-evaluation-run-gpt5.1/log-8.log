      clientBuilder.withClientName("Discovery-RemoteRegionClient-" + regionName);
    } else if ("true"
        .equals(
            System.getProperty("com.netflix.eureka.shouldSSLConnectionsUseSystemSocketFactory"))) {
      clientBuilder
          .withClientName("Discovery-RemoteRegionSystemSecureClient-" + regionName)
          .withSystemSSLConfiguration();
