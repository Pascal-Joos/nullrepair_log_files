   199        @PathParam("version") String version,
   200        @HeaderParam(HEADER_ACCEPT) String acceptHeader,
   201        @HeaderParam(HEADER_ACCEPT_ENCODING) String acceptEncoding,
   202        @HeaderParam(EurekaAccept.HTTP_X_EUREKA_ACCEPT) String 
eurekaAccept,
   203        @Context UriInfo uriInfo,
   204        @Nullable @QueryParam("regions") String regionsStr) {
