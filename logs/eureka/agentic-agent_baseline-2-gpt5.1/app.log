   248            Response.ok(responseCache.getGZIP(cacheKey))
   249                .header(HEADER_CONTENT_ENCODING, HEADER_GZIP_VALUE)
   250                .header(HEADER_CONTENT_TYPE, returnMediaType)
   251                .build();
