   237              Key.EntityType.Application,
   238              ResponseCacheImpl.ALL_APPS_DELTA,
   239              keyType,
   240              CurrentRequestVersion.get(),
   241              EurekaAccept.fromString(eurekaAccept),
   242              regions);
   243  
   244      final Response response;
   245  
   246      if (acceptEncoding != null && 
acceptEncoding.contains(HEADER_GZIP_VALUE)) {
