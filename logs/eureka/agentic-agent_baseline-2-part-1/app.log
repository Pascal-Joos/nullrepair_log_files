  @Nullable
  private ResourceRecordSet getResourceRecordSet(String domain, HostedZone 
hostedZone) {
    ListResourceRecordSetsRequest request = new ListResourceRecordSetsRequest();
    request.setMaxItems(String.valueOf(Integer.MAX_VALUE));
    request.setHostedZoneId(hostedZone.getId());

    ListResourceRecordSetsResult listResourceRecordSetsResult =
        amazonRoute53Client.listResourceRecordSets(request);

    for (ResourceRecordSet rrs : 
listResourceRecordSetsResult.getResourceRecordSets()) {
      if (rrs.getName().equals(domain)) {
