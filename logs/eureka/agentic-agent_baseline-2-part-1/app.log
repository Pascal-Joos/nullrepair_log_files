                logger.error("Could not bind to Route53", e);
              }
            }
          },
          serverConfig.getRoute53BindingRetryIntervalMs(),
          serverConfig.getRoute53BindingRetryIntervalMs());
    } catch (InterruptedException e) {
      throw new RuntimeException(e);
