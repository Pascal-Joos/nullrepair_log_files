   */
  private void scheduleRenewalThresholdUpdateTask() {
    timer.schedule(
        new TimerTask() {
          @Override
          public void run() {
            updateRenewalThreshold();
          }
        },
        serverConfig.getRenewalThresholdUpdateIntervalMs(),
        serverConfig.getRenewalThresholdUpdateIntervalMs());
  }

