      // check change not overwritten
      ResourceRecordSet resourceRecordSet =
          getResourceRecordSet(Nullability.castToNonnull(rrs.getResourceRecordSet()).getName(), rrs.getHostedZone());
      if (resourceRecordSet != null) {
