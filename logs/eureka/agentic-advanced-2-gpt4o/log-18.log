                Nullability.castToNonnull(getApplications(), "once called and stored").getRegisteredApplications(instance.getAppName()).addInstance(instance);
              } else if (ActionType.MODIFIED.equals(instance.getActionType())) {
                Application existingApp =
                    currentApplications.getRegisteredApplications(instance.getAppName());
                if (existingApp == null) {
                  currentApplications.addApplication(app);
                }
                logger.debug("Modified instance {} to the existing apps ", instance.getId());
    
                Nullability.castToNonnull(getApplications(), "once called and stored").getRegisteredApplications(instance.getAppName()).addInstance(instance);
    
              } else if (ActionType.DELETED.equals(instance.getActionType())) {
                Application existingApp =
                    currentApplications.getRegisteredApplications(instance.getAppName());
                if (existingApp == null) {
                  currentApplications.addApplication(app);
                }
                logger.debug("Deleted instance {} to the existing apps ", instance.getId());
                Nullability.castToNonnull(getApplications(), "once called and stored")
                    .getRegisteredApplications(instance.getAppName())
                    .removeInstance(instance);
              }
            }
          }
          logger.debug("The total number of instances fetched by the delta processor : {}", deltaCount);
