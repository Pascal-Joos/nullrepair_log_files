    } catch (UnknownHostException e) {
      logger.warn("Cannot find localhost ip", e);
    }
    EurekaServerIdentity identity = new EurekaServerIdentity(ip);
    discoveryApacheClient.addFilter(new EurekaIdentityHeaderFilter(identity));

