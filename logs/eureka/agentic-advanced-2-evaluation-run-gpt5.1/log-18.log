**Method:**
private void updateDelta(Applications delta) {
            int deltaCount = 0;
            Applications localApplications = getApplications();
            if (localApplications == null) {
              return;
            }
            for (Application app : delta.getRegisteredApplications()) {
              for (InstanceInfo instance : app.getInstances()) {
                ++deltaCount;
                Application existingApp =
                    localApplications.getRegisteredApplications(instance.getAppName());
                if (ActionType.ADDED.equals(instance.getActionType())) {
                  if (existingApp == null) {
                    localApplications.addApplication(app);
                    existingApp = localApplications.getRegisteredApplications(instance.getAppName());
                  }
                  logger.debug("Added instance {} to the existing apps ", instance.getId());
                  existingApp.addInstance(instance);
                } else if (ActionType.MODIFIED.equals(instance.getActionType())) {
                  if (existingApp == null) {
                    localApplications.addApplication(app);
                    existingApp = localApplications.getRegisteredApplications(instance.getAppName());
                  }
                  logger.debug("Modified instance {} to the existing apps ", instance.getId());
                  existingApp.addInstance(instance);
                } else if (ActionType.DELETED.equals(instance.getActionType())) {
                  if (existingApp == null) {
                    localApplications.addApplication(app);
                    existingApp = localApplications.getRegisteredApplications(instance.getAppName());
                  }
                  logger.debug("Deleted instance {} to the existing apps ", instance.getId());
                  existingApp.removeInstance(instance);
                }
              }
            }
            logger.debug("The total number of instances fetched by the delta processor : {}", deltaCount);
}

