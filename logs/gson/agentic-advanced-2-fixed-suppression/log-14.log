                          Node<K, V> right = stack;
                          if (right == null) {
                            break;
                          }
                          Node<K, V> center = right.parent;
                          if (center == null) {
                            break;
                          }
                          stack = center;
                          // Construct a tree with no left child.
                          center.right = right;
                          center.height = right.height + 1;
                          right.parent = center;
                          leavesSkipped = 0;
                        } else if (leavesSkipped == 2) {
                          leavesSkipped = 0;
                        }
                      }
}
