        if (LOG.isInfoEnabled()) {
          // Include the stacktrace.
          LOG.warn(
              "{}, origin = {}, origin channel info = {}",
              err.getStatusCategory().name(),
              origin.getName(),
              origChInfo,
              ex);
        } else {
          LOG.warn(
