        proxyRequestToOrigin();
      } else {
        // Record the exception in context. An error filter should later run which can translate
        // this into an
        // app-specific error response if needed.
        zuulCtx.setError(ex);
        zuulCtx.setShouldSendErrorResponse(true);

        StatusCategoryUtils.storeStatusCategoryIfNotAlreadyFailure(
