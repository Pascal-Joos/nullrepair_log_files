      // Update RequestAttempt info.
      if (currentRequestAttempt != null) {
        currentRequestAttempt.complete(-1, currentRequestStat.duration(), ex);
      }

      postErrorProcessing(ex, zuulCtx, err, chosenServer.get(), attemptNum);

