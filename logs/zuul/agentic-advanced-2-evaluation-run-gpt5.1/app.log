                "server.ssl.handshake",
                "success",
                String.valueOf(sslHandshakeCompletionEvent.isSuccess()),
                "failure_cause",
                String.valueOf(sslHandshakeCompletionEvent.cause()))
            .increment();
      }
    } catch (Exception e) {
      logger.error("Error incrememting counters for SSL handshake!", e);
    }
}
